<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:c="using:WINbackup.Controls">

    <!-- Identidade visual do Canal WINchester (ver interface/HANDOFF.md, seção 2) -->
    <SolidColorBrush x:Key="BgWindow" Color="#0a0f1c"/>
    <SolidColorBrush x:Key="BgSidebar" Color="#070b15"/>
    <SolidColorBrush x:Key="SidebarLine" Color="#141f38"/>
    <SolidColorBrush x:Key="Surface" Color="#0e1526"/>
    <SolidColorBrush x:Key="SurfaceStrong" Color="#0e1830"/>
    <SolidColorBrush x:Key="SurfaceSelected" Color="#0f1b33"/>
    <SolidColorBrush x:Key="SurfaceDeep" Color="#0a1120"/>
    <SolidColorBrush x:Key="SurfaceInfo" Color="#0b1a33"/>
    <SolidColorBrush x:Key="Line" Color="#1c2a48"/>
    <SolidColorBrush x:Key="Divider" Color="#16223d"/>
    <SolidColorBrush x:Key="LineStrong" Color="#22407a"/>
    <SolidColorBrush x:Key="LineButton" Color="#2a3b63"/>
    <SolidColorBrush x:Key="LineDashed" Color="#2f4a80"/>
    <SolidColorBrush x:Key="Blue" Color="#2f7bff"/>
    <SolidColorBrush x:Key="BlueSoft" Color="#6fa4ff"/>
    <SolidColorBrush x:Key="BlueLink" Color="#9fc3ff"/>
    <SolidColorBrush x:Key="Neon" Color="#19e3ff"/>
    <SolidColorBrush x:Key="NeonSoft" Color="#7befff"/>
    <SolidColorBrush x:Key="OnNeon" Color="#04121a"/>
    <SolidColorBrush x:Key="Selected" Color="#12203d"/>
    <SolidColorBrush x:Key="SegOn" Color="#1a2b52"/>
    <SolidColorBrush x:Key="InputBg" Color="#080d19"/>
    <SolidColorBrush x:Key="ButtonBg" Color="#101b33"/>
    <SolidColorBrush x:Key="Text" Color="#e8f0ff"/>
    <SolidColorBrush x:Key="TextNav" Color="#c9d6ee"/>
    <SolidColorBrush x:Key="TextMuted" Color="#8ea3c7"/>
    <SolidColorBrush x:Key="TextMuted2" Color="#a9badb"/>
    <SolidColorBrush x:Key="TextLabel" Color="#7f93b8"/>
    <SolidColorBrush x:Key="TextMono" Color="#d5e1f7"/>
    <SolidColorBrush x:Key="Ok" Color="#3ddc97"/>
    <SolidColorBrush x:Key="OkBg" Color="#0b2a1f"/>
    <SolidColorBrush x:Key="Warn" Color="#ffb547"/>
    <SolidColorBrush x:Key="WarnBg" Color="#1d1608"/>
    <SolidColorBrush x:Key="WarnLine" Color="#5c4413"/>
    <SolidColorBrush x:Key="WarnText" Color="#ffd89a"/>
    <SolidColorBrush x:Key="Error" Color="#ff3d5a"/>
    <SolidColorBrush x:Key="ErrorSoft" Color="#ff6b81"/>
    <SolidColorBrush x:Key="ErrorBg" Color="#2a0d15"/>
    <SolidColorBrush x:Key="ErrorLine" Color="#6a2333"/>
    <SolidColorBrush x:Key="ErrorText" Color="#ff8fa1"/>
    <SolidColorBrush x:Key="YouTube" Color="#ff5c6c"/>
    <SolidColorBrush x:Key="CyanBg" Color="#0b1f24"/>
    <SolidColorBrush x:Key="CyanLine" Color="#17616a"/>
    <SolidColorBrush x:Key="TrackOff" Color="#2a3350"/>
    <SolidColorBrush x:Key="BoxOff" Color="#3a4b70"/>
    <SolidColorBrush x:Key="DangerTrack" Color="#d9534f"/>
    <SolidColorBrush x:Key="TextStrong" Color="#ffffff"/>
    <SolidColorBrush x:Key="HoverOverlay" Color="#ffffff"/>
    <SolidColorBrush x:Key="SidebarCard" Color="#0c1426"/>
    <SolidColorBrush x:Key="SidebarDivider" Color="#1a2847"/>
    <SolidColorBrush x:Key="BadgeBg" Color="#0f1d36"/>
    <SolidColorBrush x:Key="BadgeLine" Color="#1f3560"/>
    <SolidColorBrush x:Key="ChipWarnBg" Color="#2a1f0b"/>
    <SolidColorBrush x:Key="PinkText" Color="#ff8fb8"/>
    <SolidColorBrush x:Key="PinkBg" Color="#2a0d1f"/>
    <SolidColorBrush x:Key="CyanChipBg" Color="#0b2a2e"/>
    <SolidColorBrush x:Key="ProgressTrack" Color="#13213f"/>
    <SolidColorBrush x:Key="RowLine" Color="#121c33"/>

    <FontFamily x:Key="Mono">Cascadia Mono, Consolas</FontFamily>

    <!-- Texto -->
    <Style x:Key="H1" TargetType="TextBlock">
        <Setter Property="FontSize" Value="26"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="Foreground" Value="{StaticResource Text}"/>
    </Style>
    <Style x:Key="Sub" TargetType="TextBlock">
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="Foreground" Value="{StaticResource TextMuted}"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>
    <Style x:Key="Small" TargetType="TextBlock">
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Foreground" Value="{StaticResource TextMuted}"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>
    <Style x:Key="CardTitle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{StaticResource Text}"/>
    </Style>
    <Style x:Key="Overline" TargetType="TextBlock">
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="CharacterSpacing" Value="100"/>
        <Setter Property="Foreground" Value="{StaticResource TextLabel}"/>
    </Style>
    <Style x:Key="MonoText" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource Mono}"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Foreground" Value="{StaticResource TextMuted2}"/>
        <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
    </Style>

    <!-- Cartões -->
    <Style x:Key="Card" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource Surface}"/>
        <Setter Property="BorderBrush" Value="{StaticResource Line}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="12"/>
        <Setter Property="Padding" Value="18"/>
    </Style>
    <Style x:Key="TableCard" TargetType="Border" BasedOn="{StaticResource Card}">
        <Setter Property="Padding" Value="0"/>
    </Style>
    <Style x:Key="WarnCard" TargetType="Border" BasedOn="{StaticResource Card}">
        <Setter Property="Background" Value="{StaticResource WarnBg}"/>
        <Setter Property="BorderBrush" Value="{StaticResource WarnLine}"/>
        <Setter Property="Padding" Value="18,14"/>
    </Style>
    <Style x:Key="InfoCard" TargetType="Border" BasedOn="{StaticResource Card}">
        <Setter Property="Background" Value="{StaticResource SurfaceInfo}"/>
        <Setter Property="BorderBrush" Value="{StaticResource LineStrong}"/>
        <Setter Property="Padding" Value="18,14"/>
    </Style>
    <Style x:Key="ConsoleCard" TargetType="Border" BasedOn="{StaticResource Card}">
        <Setter Property="Background" Value="{StaticResource BgSidebar}"/>
        <Setter Property="Padding" Value="16,12"/>
    </Style>
    <Style x:Key="SegHost" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource Surface}"/>
        <Setter Property="BorderBrush" Value="{StaticResource Line}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="10"/>
        <Setter Property="Padding" Value="4"/>
        <Setter Property="HorizontalAlignment" Value="Left"/>
    </Style>

    <!-- Botões: um único template plano; o hover clareia de leve, como no protótipo -->
    <ControlTemplate x:Key="FlatButtonTemplate" TargetType="Button">
        <Grid x:Name="Root" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
              BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{TemplateBinding CornerRadius}">
            <Border x:Name="Hover" Background="{StaticResource HoverOverlay}" Opacity="0"/>
            <ContentPresenter Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}"
                              Padding="{TemplateBinding Padding}" Foreground="{TemplateBinding Foreground}"
                              HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                              VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"/>
            <VisualStateManager.VisualStateGroups>
                <VisualStateGroup x:Name="CommonStates">
                    <VisualState x:Name="Normal"/>
                    <VisualState x:Name="PointerOver"><VisualState.Setters><Setter Target="Hover.Opacity" Value="0.07"/></VisualState.Setters></VisualState>
                    <VisualState x:Name="Pressed"><VisualState.Setters><Setter Target="Hover.Opacity" Value="0.12"/></VisualState.Setters></VisualState>
                    <VisualState x:Name="Disabled"><VisualState.Setters><Setter Target="Root.Opacity" Value="0.45"/></VisualState.Setters></VisualState>
                </VisualStateGroup>
            </VisualStateManager.VisualStateGroups>
        </Grid>
    </ControlTemplate>

    <Style x:Key="FlatButton" TargetType="Button">
        <Setter Property="Template" Value="{StaticResource FlatButtonTemplate}"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderBrush" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Foreground" Value="{StaticResource Text}"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="CornerRadius" Value="8"/>
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="UseSystemFocusVisuals" Value="True"/>
        <Setter Property="FocusVisualPrimaryBrush" Value="{StaticResource Neon}"/>
    </Style>
    <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource FlatButton}">
        <Setter Property="Background" Value="{StaticResource Neon}"/>
        <Setter Property="Foreground" Value="{StaticResource OnNeon}"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="Height" Value="44"/>
        <Setter Property="Padding" Value="22,0"/>
    </Style>
    <Style x:Key="SecondaryButton" TargetType="Button" BasedOn="{StaticResource FlatButton}">
        <Setter Property="BorderBrush" Value="{StaticResource LineButton}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="Height" Value="44"/>
        <Setter Property="Padding" Value="18,0"/>
    </Style>
    <Style x:Key="AccentButton" TargetType="Button" BasedOn="{StaticResource SecondaryButton}">
        <Setter Property="Background" Value="{StaticResource Selected}"/>
        <Setter Property="BorderBrush" Value="{StaticResource Blue}"/>
        <Setter Property="Foreground" Value="{StaticResource TextStrong}"/>
    </Style>
    <Style x:Key="DangerButton" TargetType="Button" BasedOn="{StaticResource SecondaryButton}">
        <Setter Property="Background" Value="{StaticResource ErrorBg}"/>
        <Setter Property="BorderBrush" Value="{StaticResource ErrorLine}"/>
        <Setter Property="Foreground" Value="{StaticResource ErrorText}"/>
    </Style>
    <Style x:Key="WarnButton" TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
        <Setter Property="Background" Value="{StaticResource Warn}"/>
        <Setter Property="Foreground" Value="#1a1205"/>
        <Setter Property="Height" Value="40"/>
        <Setter Property="Padding" Value="16,0"/>
        <Setter Property="FontSize" Value="13"/>
    </Style>
    <Style x:Key="SmallButton" TargetType="Button" BasedOn="{StaticResource FlatButton}">
        <Setter Property="Background" Value="{StaticResource ButtonBg}"/>
        <Setter Property="BorderBrush" Value="{StaticResource LineButton}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Height" Value="36"/>
        <Setter Property="Padding" Value="14,0"/>
    </Style>
    <Style x:Key="LinkButton" TargetType="Button" BasedOn="{StaticResource FlatButton}">
        <Setter Property="Foreground" Value="{StaticResource Neon}"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="CornerRadius" Value="4"/>
        <Setter Property="Padding" Value="2,0"/>
    </Style>
    <Style x:Key="RowButton" TargetType="Button" BasedOn="{StaticResource FlatButton}">
        <Setter Property="HorizontalAlignment" Value="Stretch"/>
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        <Setter Property="CornerRadius" Value="6"/>
    </Style>

    <!-- Botões grandes do Início: azul neutro, neon no hover -->
    <Style x:Key="HeroButton" TargetType="Button">
        <Setter Property="MaxWidth" Value="340"/>
        <Setter Property="HorizontalAlignment" Value="Stretch"/>
        <Setter Property="Height" Value="230"/>
        <Setter Property="Foreground" Value="{StaticResource Text}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid x:Name="Root" Background="{StaticResource Surface}" BorderBrush="{StaticResource Blue}" BorderThickness="1" CornerRadius="16">
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="16">
                            <Border x:Name="Circle" Width="72" Height="72" CornerRadius="36" HorizontalAlignment="Center"
                                    Background="{StaticResource SegOn}" BorderBrush="{StaticResource Blue}" BorderThickness="1.5">
                                <c:Icon x:Name="Glyph" Width="34" Height="34" StrokeThickness="2.25" Foreground="{StaticResource TextStrong}"
                                        Data="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}"/>
                            </Border>
                            <ContentPresenter Content="{TemplateBinding Content}" HorizontalAlignment="Center"/>
                        </StackPanel>
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="CommonStates">
                                <VisualState x:Name="Normal"/>
                                <VisualState x:Name="PointerOver">
                                    <VisualState.Setters>
                                        <Setter Target="Root.Background" Value="{StaticResource SurfaceStrong}"/>
                                        <Setter Target="Root.BorderBrush" Value="{StaticResource Neon}"/>
                                        <Setter Target="Circle.Background" Value="{StaticResource Neon}"/>
                                        <Setter Target="Circle.BorderBrush" Value="{StaticResource Neon}"/>
                                        <Setter Target="Glyph.Foreground" Value="{StaticResource OnNeon}"/>
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Pressed">
                                    <VisualState.Setters>
                                        <Setter Target="Root.Background" Value="{StaticResource SurfaceStrong}"/>
                                        <Setter Target="Root.BorderBrush" Value="{StaticResource Neon}"/>
                                        <Setter Target="Circle.Background" Value="{StaticResource Neon}"/>
                                        <Setter Target="Circle.BorderBrush" Value="{StaticResource Neon}"/>
                                        <Setter Target="Glyph.Foreground" Value="{StaticResource OnNeon}"/>
                                        <Setter Target="Root.Opacity" Value="0.9"/>
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Disabled"><VisualState.Setters><Setter Target="Root.Opacity" Value="0.5"/></VisualState.Setters></VisualState>
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Interruptor 40x22. Background = trilho desligado, BorderBrush = trilho ligado -->
    <Style x:Key="Switch" TargetType="ToggleButton">
        <Setter Property="Background" Value="{StaticResource TrackOff}"/>
        <Setter Property="BorderBrush" Value="{StaticResource Blue}"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="UseSystemFocusVisuals" Value="True"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Grid x:Name="Root" Width="40" Height="22" Background="Transparent">
                        <Border CornerRadius="11" Background="{TemplateBinding Background}"/>
                        <Border x:Name="OnTrack" CornerRadius="11" Background="{TemplateBinding BorderBrush}" Opacity="0"/>
                        <Ellipse x:Name="Knob" Width="16" Height="16" Fill="White" HorizontalAlignment="Left" Margin="3,0,0,0"/>
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="CommonStates">
                                <VisualState x:Name="Normal"/>
                                <VisualState x:Name="PointerOver"/>
                                <VisualState x:Name="Pressed"/>
                                <VisualState x:Name="Disabled"><VisualState.Setters><Setter Target="Root.Opacity" Value="0.4"/></VisualState.Setters></VisualState>
                                <VisualState x:Name="Checked"><VisualState.Setters><Setter Target="OnTrack.Opacity" Value="1"/><Setter Target="Knob.Margin" Value="21,0,0,0"/></VisualState.Setters></VisualState>
                                <VisualState x:Name="CheckedPointerOver"><VisualState.Setters><Setter Target="OnTrack.Opacity" Value="1"/><Setter Target="Knob.Margin" Value="21,0,0,0"/></VisualState.Setters></VisualState>
                                <VisualState x:Name="CheckedPressed"><VisualState.Setters><Setter Target="OnTrack.Opacity" Value="1"/><Setter Target="Knob.Margin" Value="21,0,0,0"/></VisualState.Setters></VisualState>
                                <VisualState x:Name="CheckedDisabled"><VisualState.Setters><Setter Target="OnTrack.Opacity" Value="1"/><Setter Target="Knob.Margin" Value="21,0,0,0"/><Setter Target="Root.Opacity" Value="0.4"/></VisualState.Setters></VisualState>
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Linha de tabela inteira clicável com caixa de seleção à esquerda -->
    <Style x:Key="CheckRow" TargetType="ToggleButton">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderBrush" Value="{StaticResource Divider}"/>
        <Setter Property="BorderThickness" Value="0,0,0,1"/>
        <Setter Property="Foreground" Value="{StaticResource Text}"/>
        <Setter Property="Padding" Value="18,11"/>
        <Setter Property="HorizontalAlignment" Value="Stretch"/>
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        <Setter Property="UseSystemFocusVisuals" Value="True"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Grid x:Name="Root" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                          BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{TemplateBinding CornerRadius}">
                        <Border x:Name="Hover" Background="{StaticResource HoverOverlay}" Opacity="0"/>
                        <Grid Padding="{TemplateBinding Padding}" ColumnSpacing="18">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="18"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <Border x:Name="Box" Width="18" Height="18" CornerRadius="5" BorderThickness="1.5" BorderBrush="{StaticResource BoxOff}" VerticalAlignment="Center">
                                <c:Icon x:Name="Tick" Width="12" Height="12" StrokeThickness="3.5" Foreground="{StaticResource OnNeon}" Data="m5 12 5 5L20 7" Opacity="0"/>
                            </Border>
                            <ContentPresenter Grid.Column="1" Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}"
                                              Foreground="{TemplateBinding Foreground}" HorizontalContentAlignment="Stretch" VerticalAlignment="Center"/>
                        </Grid>
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="CommonStates">
                                <VisualState x:Name="Normal"/>
                                <VisualState x:Name="PointerOver"><VisualState.Setters><Setter Target="Hover.Opacity" Value="0.03"/></VisualState.Setters></VisualState>
                                <VisualState x:Name="Pressed"><VisualState.Setters><Setter Target="Hover.Opacity" Value="0.06"/></VisualState.Setters></VisualState>
                                <VisualState x:Name="Disabled"><VisualState.Setters><Setter Target="Root.Opacity" Value="0.5"/></VisualState.Setters></VisualState>
                                <VisualState x:Name="Checked"><VisualState.Setters><Setter Target="Box.Background" Value="{StaticResource Neon}"/><Setter Target="Box.BorderBrush" Value="{StaticResource Neon}"/><Setter Target="Tick.Opacity" Value="1"/></VisualState.Setters></VisualState>
                                <VisualState x:Name="CheckedPointerOver"><VisualState.Setters><Setter Target="Hover.Opacity" Value="0.03"/><Setter Target="Box.Background" Value="{StaticResource Neon}"/><Setter Target="Box.BorderBrush" Value="{StaticResource Neon}"/><Setter Target="Tick.Opacity" Value="1"/></VisualState.Setters></VisualState>
                                <VisualState x:Name="CheckedPressed"><VisualState.Setters><Setter Target="Hover.Opacity" Value="0.06"/><Setter Target="Box.Background" Value="{StaticResource Neon}"/><Setter Target="Box.BorderBrush" Value="{StaticResource Neon}"/><Setter Target="Tick.Opacity" Value="1"/></VisualState.Setters></VisualState>
                                <VisualState x:Name="CheckedDisabled"><VisualState.Setters><Setter Target="Root.Opacity" Value="0.5"/><Setter Target="Box.Background" Value="{StaticResource Neon}"/><Setter Target="Box.BorderBrush" Value="{StaticResource Neon}"/><Setter Target="Tick.Opacity" Value="1"/></VisualState.Setters></VisualState>
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Cartão selecionável (pastas, perfis): a borda e o fundo mudam quando marcado -->
    <Style x:Key="CheckCard" TargetType="ToggleButton" BasedOn="{StaticResource CheckRow}">
        <Setter Property="Background" Value="{StaticResource Surface}"/>
        <Setter Property="BorderBrush" Value="{StaticResource Line}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="10"/>
        <Setter Property="Padding" Value="14,12"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Grid x:Name="Root" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                          BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{TemplateBinding CornerRadius}">
                        <Border x:Name="Hover" Background="{StaticResource HoverOverlay}" Opacity="0"/>
                        <Grid Padding="{TemplateBinding Padding}" ColumnSpacing="12">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="20"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <Border x:Name="Box" Width="20" Height="20" CornerRadius="5" BorderThickness="1.5" BorderBrush="{StaticResource BoxOff}" VerticalAlignment="Center">
                                <c:Icon x:Name="Tick" Width="14" Height="14" StrokeThickness="3" Foreground="{StaticResource OnNeon}" Data="m5 12 5 5L20 7" Opacity="0"/>
                            </Border>
                            <ContentPresenter Grid.Column="1" Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}"
                                              Foreground="{TemplateBinding Foreground}" HorizontalContentAlignment="Stretch" VerticalAlignment="Center"/>
                        </Grid>
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="CommonStates">
                                <VisualState x:Name="Normal"/>
                                <VisualState x:Name="PointerOver"><VisualState.Setters><Setter Target="Hover.Opacity" Value="0.04"/></VisualState.Setters></VisualState>
                                <VisualState x:Name="Pressed"><VisualState.Setters><Setter Target="Hover.Opacity" Value="0.07"/></VisualState.Setters></VisualState>
                                <VisualState x:Name="Disabled"><VisualState.Setters><Setter Target="Root.Opacity" Value="0.5"/></VisualState.Setters></VisualState>
                                <VisualState x:Name="Checked"><VisualState.Setters><Setter Target="Root.Background" Value="{StaticResource SurfaceSelected}"/><Setter Target="Root.BorderBrush" Value="{StaticResource LineStrong}"/><Setter Target="Box.Background" Value="{StaticResource Neon}"/><Setter Target="Box.BorderBrush" Value="{StaticResource Neon}"/><Setter Target="Tick.Opacity" Value="1"/></VisualState.Setters></VisualState>
                                <VisualState x:Name="CheckedPointerOver"><VisualState.Setters><Setter Target="Hover.Opacity" Value="0.04"/><Setter Target="Root.Background" Value="{StaticResource SurfaceSelected}"/><Setter Target="Root.BorderBrush" Value="{StaticResource LineStrong}"/><Setter Target="Box.Background" Value="{StaticResource Neon}"/><Setter Target="Box.BorderBrush" Value="{StaticResource Neon}"/><Setter Target="Tick.Opacity" Value="1"/></VisualState.Setters></VisualState>
                                <VisualState x:Name="CheckedPressed"><VisualState.Setters><Setter Target="Hover.Opacity" Value="0.07"/><Setter Target="Root.Background" Value="{StaticResource SurfaceSelected}"/><Setter Target="Root.BorderBrush" Value="{StaticResource LineStrong}"/><Setter Target="Box.Background" Value="{StaticResource Neon}"/><Setter Target="Box.BorderBrush" Value="{StaticResource Neon}"/><Setter Target="Tick.Opacity" Value="1"/></VisualState.Setters></VisualState>
                                <VisualState x:Name="CheckedDisabled"><VisualState.Setters><Setter Target="Root.Opacity" Value="0.5"/><Setter Target="Box.Background" Value="{StaticResource Neon}"/><Setter Target="Box.BorderBrush" Value="{StaticResource Neon}"/><Setter Target="Tick.Opacity" Value="1"/></VisualState.Setters></VisualState>
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Pílula alternável (filtros, "Marcar: Só locais / Todos") -->
    <Style x:Key="PillToggle" TargetType="ToggleButton">
        <Setter Property="Height" Value="26"/>
        <Setter Property="Padding" Value="10,0"/>
        <Setter Property="FontSize" Value="11.5"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{StaticResource TextMuted2}"/>
        <Setter Property="UseSystemFocusVisuals" Value="True"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Grid x:Name="Root" Background="Transparent" BorderBrush="{StaticResource LineButton}" BorderThickness="1" CornerRadius="7">
                        <Border x:Name="Hover" Background="{StaticResource HoverOverlay}" Opacity="0" CornerRadius="7"/>
                        <ContentPresenter x:Name="CP" Content="{TemplateBinding Content}" Padding="{TemplateBinding Padding}"
                                          Foreground="{TemplateBinding Foreground}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="CommonStates">
                                <VisualState x:Name="Normal"/>
                                <VisualState x:Name="PointerOver"><VisualState.Setters><Setter Target="Hover.Opacity" Value="0.06"/></VisualState.Setters></VisualState>
                                <VisualState x:Name="Pressed"><VisualState.Setters><Setter Target="Hover.Opacity" Value="0.1"/></VisualState.Setters></VisualState>
                                <VisualState x:Name="Disabled"><VisualState.Setters><Setter Target="Root.Opacity" Value="0.45"/></VisualState.Setters></VisualState>
                                <VisualState x:Name="Checked"><VisualState.Setters><Setter Target="Root.Background" Value="{StaticResource Selected}"/><Setter Target="Root.BorderBrush" Value="{StaticResource Blue}"/><Setter Target="CP.Foreground" Value="{StaticResource TextStrong}"/></VisualState.Setters></VisualState>
                                <VisualState x:Name="CheckedPointerOver"><VisualState.Setters><Setter Target="Hover.Opacity" Value="0.06"/><Setter Target="Root.Background" Value="{StaticResource Selected}"/><Setter Target="Root.BorderBrush" Value="{StaticResource Blue}"/><Setter Target="CP.Foreground" Value="{StaticResource TextStrong}"/></VisualState.Setters></VisualState>
                                <VisualState x:Name="CheckedPressed"><VisualState.Setters><Setter Target="Root.Background" Value="{StaticResource Selected}"/><Setter Target="Root.BorderBrush" Value="{StaticResource Blue}"/><Setter Target="CP.Foreground" Value="{StaticResource TextStrong}"/></VisualState.Setters></VisualState>
                                <VisualState x:Name="CheckedDisabled"><VisualState.Setters><Setter Target="Root.Opacity" Value="0.45"/><Setter Target="Root.Background" Value="{StaticResource Selected}"/></VisualState.Setters></VisualState>
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="FilterPill" TargetType="ToggleButton" BasedOn="{StaticResource PillToggle}">
        <Setter Property="Height" Value="32"/>
