                                <VisualState x:Name="CheckedPointerOver"><VisualState.Setters><Setter Target="Root.Background" Value="{StaticResource Neon}"/><Setter Target="Root.BorderBrush" Value="{StaticResource Neon}"/><Setter Target="CP.Foreground" Value="{StaticResource OnNeon}"/></VisualState.Setters></VisualState>
                                <VisualState x:Name="CheckedPressed"><VisualState.Setters><Setter Target="Root.Background" Value="{StaticResource Neon}"/><Setter Target="CP.Foreground" Value="{StaticResource OnNeon}"/></VisualState.Setters></VisualState>
