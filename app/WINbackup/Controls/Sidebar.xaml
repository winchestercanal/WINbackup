<UserControl
    x:Class="WINbackup.Controls.Sidebar"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:c="using:WINbackup.Controls">

    <Grid Background="{StaticResource BgSidebar}" BorderBrush="{StaticResource SidebarLine}" BorderThickness="0,0,1,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="10,14,10,0">
            <StackPanel x:Name="NavPanel" Spacing="2" AutomationProperties.Name="Seções"/>
        </ScrollViewer>

        <StackPanel Grid.Row="1" Spacing="2" Padding="10,10,10,14">
            <!-- Destino dos backups: um só para todas as telas -->
            <Button x:Name="DestButton" Style="{StaticResource RowButton}" CornerRadius="10" Padding="12"
                    Background="#0c1426" BorderBrush="{StaticResource LineStrong}" BorderThickness="1">
                <Button.Flyout>
                    <Flyout x:Name="DestFlyout" Placement="Top" Opening="OnDestOpening">
                        <Flyout.FlyoutPresenterStyle>
                            <Style TargetType="FlyoutPresenter">
                                <Setter Property="Padding" Value="6"/>
                                <Setter Property="CornerRadius" Value="10"/>
                                <Setter Property="MinWidth" Value="228"/>
                                <Setter Property="MaxWidth" Value="320"/>
                            </Style>
                        </Flyout.FlyoutPresenterStyle>
                        <StackPanel Spacing="2">
                            <TextBlock Text="SALVAR BACKUPS EM" FontSize="11" FontWeight="Bold" CharacterSpacing="90"
                                       Foreground="{StaticResource TextLabel}" Margin="8,6,8,4"/>
                            <StackPanel x:Name="DestList" Spacing="2"/>
                            <Border Height="1" Background="#1a2847" Margin="0,4"/>
                            <Button Style="{StaticResource RowButton}" Padding="8" Click="OnBrowse" Foreground="{StaticResource BlueLink}">
                                <StackPanel Orientation="Horizontal" Spacing="10">
                                    <c:Icon Width="16" Height="16" Data="M3 6a1 1 0 0 1 1-1h5l2 2h9a1 1 0 0 1 1 1v10a1 1 0 0 1-1 1H4a1 1 0 0 1-1-1zM12 11v5M9.5 13.5h5"/>
                                    <TextBlock Text="Procurar outra pasta…" FontSize="12.5" FontWeight="SemiBold"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Flyout>
                </Button.Flyout>
                <StackPanel Spacing="7">
                    <Grid>
                        <TextBlock Text="DESTINO DOS BACKUPS" FontSize="11" FontWeight="Bold" CharacterSpacing="90" Foreground="{StaticResource TextLabel}"/>
                        <TextBlock Text="Alterar" FontSize="11.5" FontWeight="SemiBold" Foreground="{StaticResource Neon}" HorizontalAlignment="Right"/>
                    </Grid>
                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <c:Icon x:Name="DestIcon" Width="16" Height="16" Foreground="{StaticResource Neon}" VerticalAlignment="Center"/>
                        <StackPanel Grid.Column="1" Spacing="1">
                            <TextBlock x:Name="DestLabel" FontSize="13" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                            <TextBlock x:Name="DestPath" FontSize="11.5" FontFamily="{StaticResource Mono}" Foreground="{StaticResource TextMuted2}" TextTrimming="CharacterEllipsis"/>
                        </StackPanel>
                        <Ellipse x:Name="DestDot" Grid.Column="2" Width="8" Height="8" Fill="{StaticResource Ok}" VerticalAlignment="Center"/>
                    </Grid>
                    <Grid Height="6" CornerRadius="3" Background="#1a2847">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition x:Name="UsedCol" Width="0*"/>
                            <ColumnDefinition x:Name="FreeCol" Width="1*"/>
                        </Grid.ColumnDefinitions>
                        <Border Background="{StaticResource Blue}"/>
                    </Grid>
                    <TextBlock x:Name="DestSpace" FontSize="11.5" Foreground="{StaticResource TextMuted}"/>
                </StackPanel>
            </Button>

            <Button x:Name="OptionsButton" AutomationProperties.Name="Opções" Style="{StaticResource RowButton}" Height="36" Padding="12,0" Margin="0,6,0,0" Click="OnOptions">
                <Grid>
                    <Border x:Name="OptionsPill" Width="3" Height="18" CornerRadius="2" HorizontalAlignment="Left" Margin="-12,0,0,0"/>
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <c:Icon Width="18" Height="18" Data="M12 9a3 3 0 1 0 0 6a3 3 0 1 0 0-6zM12 2v3M12 19v3M2 12h3M19 12h3M4.9 4.9l2.1 2.1M17 17l2.1 2.1M4.9 19.1 7 17M17 7l2.1-2.1"/>
                        <TextBlock Text="Opções" FontSize="14" VerticalAlignment="Center"/>
                    </StackPanel>
                </Grid>
            </Button>
            <Button x:Name="DonateButton" AutomationProperties.Name="Apoie o projeto" Style="{StaticResource RowButton}" Height="36" Padding="12,0" Foreground="#ff8fb8" Click="OnDonate">
                <Grid>
                    <Border x:Name="DonatePill" Width="3" Height="18" CornerRadius="2" HorizontalAlignment="Left" Margin="-12,0,0,0"/>
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <c:Icon Width="18" Height="18" Data="M12 20s-7-4.4-7-10a4 4 0 0 1 7-2.6A4 4 0 0 1 19 10c0 5.6-7 10-7 10z"/>
                        <TextBlock Text="Apoie o projeto" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    </StackPanel>
                </Grid>
            </Button>
            <Button Style="{StaticResource RowButton}" Height="36" Padding="12,0" Foreground="{StaticResource YouTube}" Click="OnYouTube">
                <StackPanel Orientation="Horizontal" Spacing="12">
                    <c:Icon Width="18" Height="18" Data="M6.5 5h11A4 4 0 0 1 21.5 9v6a4 4 0 0 1-4 4h-11a4 4 0 0 1-4-4V9a4 4 0 0 1 4-4zM10 9l5 3-5 3z"/>
                    <TextBlock Text="Tutorial no YouTube" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>
        </StackPanel>
    </Grid>
</UserControl>
