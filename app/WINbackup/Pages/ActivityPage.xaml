<Page
    x:Class="WINbackup.Pages.ActivityPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:s="using:WINbackup.Services"
    xmlns:c="using:WINbackup.Controls">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Spacing="20" Padding="36,28,36,36">
            <StackPanel Spacing="4">
                <TextBlock Text="{s:T K='Atividade'}" Style="{StaticResource H1}"/>
                <TextBlock Text="{s:T K='O que já rodou, o que vai rodar e o que está vigiando o seu HD externo.'}" Style="{StaticResource Sub}"/>
            </StackPanel>

            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                <Border Style="{StaticResource Card}" Padding="18,16">
                    <StackPanel Spacing="4">
                        <TextBlock Text="{s:T K='Último backup'}" Style="{StaticResource Small}"/>
                        <TextBlock x:Name="LastText" FontSize="18" FontWeight="Bold"/>
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <Ellipse x:Name="LastDot" Width="7" Height="7" VerticalAlignment="Center"/>
                            <TextBlock x:Name="LastStatus" FontSize="12"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
                <Border Grid.Column="1" Style="{StaticResource Card}" Padding="18,16">
                    <StackPanel Spacing="4">
                        <TextBlock Text="{s:T K='Próximo agendado'}" Style="{StaticResource Small}"/>
                        <TextBlock x:Name="NextText" FontSize="18" FontWeight="Bold"/>
                        <TextBlock x:Name="NextWhat" FontSize="12" Foreground="{StaticResource TextMuted2}"/>
                    </StackPanel>
                </Border>
                <Border Grid.Column="2" Style="{StaticResource Card}" Padding="18,16">
                    <StackPanel Spacing="4">
                        <TextBlock Text="{s:T K='Destino'}" Style="{StaticResource Small}"/>
                        <TextBlock x:Name="DestText" FontSize="18" FontWeight="Bold" TextTrimming="CharacterEllipsis"/>
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <Ellipse x:Name="DestDot" Width="7" Height="7" VerticalAlignment="Center"/>
                            <TextBlock x:Name="DestStatus" FontSize="12"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Grid>

            <Grid ColumnSpacing="16">
                <Grid.ColumnDefinitions><ColumnDefinition Width="1*"/><ColumnDefinition Width="1.2*"/></Grid.ColumnDefinitions>
                <Border Style="{StaticResource TableCard}" VerticalAlignment="Top">
                    <StackPanel x:Name="AutoPanel">
                        <Grid Padding="18,14" BorderBrush="{StaticResource Divider}" BorderThickness="0,0,0,1">
                            <TextBlock Text="{s:T K='Automação'}" FontSize="15" FontWeight="SemiBold"/>
                            <Button Style="{StaticResource LinkButton}" Content="{s:T K='Gerenciar'}" HorizontalAlignment="Right" Click="OnSchedule"/>
                        </Grid>
                    </StackPanel>
                </Border>
                <Border Grid.Column="1" Style="{StaticResource TableCard}" VerticalAlignment="Top">
                    <StackPanel x:Name="RecentPanel">
                        <Grid Padding="18,14" BorderBrush="{StaticResource Divider}" BorderThickness="0,0,0,1">
                            <TextBlock Text="{s:T K='Atividade recente'}" FontSize="15" FontWeight="SemiBold"/>
                            <Button Style="{StaticResource LinkButton}" Content="{s:T K='Ver histórico completo'}" HorizontalAlignment="Right" Click="OnHistory"/>
                        </Grid>
                    </StackPanel>
                </Border>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</Page>
