<Page
    x:Class="WINbackup.Pages.ProgressPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:s="using:WINbackup.Services"
    xmlns:c="using:WINbackup.Controls"
    xmlns:m="using:WINbackup.Models">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Spacing="18" Padding="36,28,36,36">
            <Grid ColumnSpacing="16">
                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel Spacing="4">
                    <TextBlock x:Name="StateLabel" Text="{s:T K='EM ANDAMENTO'}" FontSize="12" FontWeight="Bold" CharacterSpacing="100" Foreground="{StaticResource Neon}"/>
                    <TextBlock x:Name="TitleText" Style="{StaticResource H1}"/>
                    <TextBlock x:Name="SubText" Text="{s:T K='Pode continuar usando o PC. Você recebe uma notificação quando terminar.'}" Style="{StaticResource Sub}"/>
                </StackPanel>
                <Border x:Name="HashBadge" Grid.Column="1" VerticalAlignment="Bottom" Padding="12,6" CornerRadius="6"
                        Background="{StaticResource CyanBg}" BorderBrush="{StaticResource CyanLine}" BorderThickness="1">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <c:Icon Width="12" Height="12" StrokeThickness="2.5" Data="m5 12 5 5L20 7" Foreground="{StaticResource NeonSoft}"/>
                        <TextBlock Text="{s:T K='Verificação SHA-256 ativa'}" FontSize="12" Foreground="{StaticResource NeonSoft}"/>
                    </StackPanel>
                </Border>
            </Grid>

            <Border Padding="24,22" CornerRadius="12" Background="{StaticResource SurfaceStrong}" BorderBrush="{StaticResource LineStrong}" BorderThickness="1">
                <StackPanel Spacing="14">
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <TextBlock x:Name="NowText" FontSize="15" VerticalAlignment="Bottom" TextTrimming="CharacterEllipsis" Margin="0,0,0,8"/>
                        <TextBlock x:Name="PercentText" Grid.Column="1" Text="0%" FontSize="40" FontWeight="ExtraBold" FontFamily="{StaticResource Mono}" Foreground="{StaticResource TextStrong}"/>
                    </Grid>
                    <Grid Height="10" CornerRadius="5" Background="{StaticResource ProgressTrack}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition x:Name="DoneCol" Width="0*"/>
                            <ColumnDefinition x:Name="LeftCol" Width="1*"/>
                        </Grid.ColumnDefinitions>
                        <Border x:Name="Bar" CornerRadius="5" Background="{StaticResource Neon}"/>
                    </Grid>
                    <Grid>
                        <TextBlock x:Name="BytesText" FontSize="12" FontFamily="{StaticResource Mono}" Foreground="{StaticResource TextMuted2}"/>
                        <TextBlock x:Name="EtaText" FontSize="12" FontFamily="{StaticResource Mono}" Foreground="{StaticResource TextMuted2}" HorizontalAlignment="Right"/>
                    </Grid>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource TableCard}">
                <ItemsRepeater x:Name="StepsRepeater" Margin="0,0,-1,-1">
                    <ItemsRepeater.Layout>
                        <UniformGridLayout MaximumRowsOrColumns="3" ItemsStretch="Fill" MinItemWidth="200"/>
                    </ItemsRepeater.Layout>
                    <ItemsRepeater.ItemTemplate>
                        <DataTemplate x:DataType="m:StepItem">
                            <Border Padding="16,13" BorderBrush="{StaticResource Divider}" BorderThickness="0,0,1,1">
                                <Grid ColumnSpacing="12">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/></Grid.ColumnDefinitions>
                                    <Border Width="22" Height="22" CornerRadius="11" BorderThickness="1.5" BorderBrush="{x:Bind Ring, Mode=OneWay}" Background="{x:Bind Fill, Mode=OneWay}" VerticalAlignment="Center">
                                        <c:Icon Width="12" Height="12" StrokeThickness="3.5" Data="m5 12 5 5L20 7" Foreground="{StaticResource OnNeon}" Visibility="{x:Bind TickVisibility, Mode=OneWay}"/>
                                    </Border>
                                    <StackPanel Grid.Column="1" Spacing="2">
                                        <TextBlock Text="{x:Bind Name}" FontSize="13" FontWeight="{x:Bind Weight, Mode=OneWay}" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Text="{x:Bind Status, Mode=OneWay}" FontSize="12" Foreground="{x:Bind StatusBrush, Mode=OneWay}" TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsRepeater.ItemTemplate>
                </ItemsRepeater>
            </Border>

            <Border Style="{StaticResource ConsoleCard}" MinHeight="60">
                <ItemsControl x:Name="LogList">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="m:LogLine">
                            <TextBlock FontFamily="{StaticResource Mono}" FontSize="12" LineHeight="19" TextTrimming="CharacterEllipsis">
                                <Run Text="{x:Bind Time}" Foreground="{StaticResource TextLabel}"/>
                                <Run Text="{x:Bind LevelTag}" Foreground="{x:Bind LevelBrush}"/>
                                <Run Text="{x:Bind Message}"/>
                            </TextBlock>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Border>

            <StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Right">
                <Button x:Name="OpenLogButton" Style="{StaticResource FlatButton}" Height="44" Padding="16,0" FontSize="13" Foreground="{StaticResource TextMuted}" Content="{s:T K='Abrir log'}" Click="OnOpenLog"/>
                <Button x:Name="PauseButton" Style="{StaticResource SecondaryButton}" Content="{s:T K='Pausar'}" Click="OnPause"/>
                <Button x:Name="CancelButton" Style="{StaticResource DangerButton}" Content="{s:T K='Cancelar'}" Click="OnCancel"/>
                <Button x:Name="ReportButton" Style="{StaticResource PrimaryButton}" Content="{s:T K='Ver relatório'}" Click="OnReport" Visibility="Collapsed"/>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</Page>
