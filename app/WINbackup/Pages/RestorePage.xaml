<Page
    x:Class="WINbackup.Pages.RestorePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:s="using:WINbackup.Services"
    xmlns:c="using:WINbackup.Controls"
    xmlns:m="using:WINbackup.Models">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Spacing="18" Padding="36,28,36,36">
            <Grid ColumnSpacing="16">
                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel Spacing="4">
                    <TextBlock Text="{s:T K='Restaurar backup'}" Style="{StaticResource H1}"/>
                    <TextBlock Text="{s:T K='Escolha a versão, navegue pelo conteúdo e traga de volta só o que precisa.'}" Style="{StaticResource Sub}"/>
                </StackPanel>
                <Button Grid.Column="1" Style="{StaticResource AccentButton}" Height="36" Padding="14,0" FontSize="13" VerticalAlignment="Bottom" Click="OnWizard">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <c:Icon Width="14" Height="14" StrokeThickness="2" Data="M5 19 15 9M14 4v3M12.5 5.5h3M19 9v3M17.5 10.5h3"/>
                        <TextBlock Text="{s:T K='Restaurar tudo (pós-formatação)'}"/>
                    </StackPanel>
                </Button>
            </Grid>

            <Grid x:Name="MainGrid" ColumnSpacing="16">
                <Grid.ColumnDefinitions><ColumnDefinition Width="340"/><ColumnDefinition/></Grid.ColumnDefinitions>
                <StackPanel Spacing="14">
                    <Border Style="{StaticResource Card}" Padding="16">
                        <StackPanel Spacing="8">
                            <TextBlock Text="{s:T K='Local do backup'}" FontSize="13" FontWeight="SemiBold"/>
                            <Grid ColumnSpacing="8">
                                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <TextBox x:Name="SourceBox" Style="{StaticResource MonoInput}" AutomationProperties.Name="{s:T K='Local do backup'}" KeyDown="OnSourceKey" LostFocus="OnSourceLostFocus"/>
                                <Button Grid.Column="1" Style="{StaticResource SmallButton}" Padding="12,0" FontSize="12" Content="{s:T K='Procurar…'}" Click="OnBrowse"/>
                            </Grid>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource TableCard}">
                        <StackPanel>
                            <Border Padding="16,12" BorderBrush="{StaticResource Divider}" BorderThickness="0,0,0,1">
                                <TextBlock Text="{s:T K='Versões'}" FontSize="13" FontWeight="SemiBold"/>
                            </Border>
                            <StackPanel x:Name="VersionsPanel"/>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <Border Grid.Column="1" Style="{StaticResource TableCard}" VerticalAlignment="Top">
                    <StackPanel>
                        <Grid Padding="16,12" ColumnSpacing="10" BorderBrush="{StaticResource Divider}" BorderThickness="0,0,0,1">
                            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <TextBlock x:Name="ContentTitle" Text="{s:T K='Conteúdo do backup'}" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                            <TextBox x:Name="SearchBox" Grid.Column="1" Style="{StaticResource Input}" Width="200" Height="30" MinHeight="30" FontSize="12"
                                     PlaceholderText="{s:T K='Buscar arquivo…'}" AutomationProperties.Name="{s:T K='Buscar arquivo'}" TextChanged="OnSearch"/>
                        </Grid>
                        <ItemsRepeater x:Name="Tree">
                            <ItemsRepeater.ItemTemplate>
                                <DataTemplate x:DataType="m:CheckItem">
                                    <ToggleButton Style="{StaticResource CheckRow}" Padding="{x:Bind Indent}" BorderBrush="{StaticResource RowLine}" IsChecked="{x:Bind IsChecked, Mode=TwoWay}"
                                                  IsEnabled="{x:Bind Enabled, Mode=OneWay}" AutomationProperties.Name="{x:Bind Title}">
                                        <Grid ColumnSpacing="10">
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                            <c:Icon Width="16" Height="16" Data="{x:Bind Icon}" Foreground="{x:Bind MetaBrush}"/>
                                            <StackPanel Grid.Column="1" Spacing="1" VerticalAlignment="Center">
                                                <TextBlock Text="{x:Bind Title}" FontSize="13" FontWeight="{x:Bind Weight}" TextTrimming="CharacterEllipsis"/>
                                                <TextBlock Text="{x:Bind Subtitle}" FontSize="11.5" Foreground="{StaticResource TextLabel}" FontFamily="{StaticResource Mono}"
                                                           TextTrimming="CharacterEllipsis" Visibility="{x:Bind FlagVisibility}"/>
                                            </StackPanel>
                                            <TextBlock Grid.Column="2" Text="{x:Bind Meta}" FontSize="12" Foreground="{StaticResource TextMuted}" VerticalAlignment="Center"/>
                                        </Grid>
                                    </ToggleButton>
                                </DataTemplate>
                            </ItemsRepeater.ItemTemplate>
                        </ItemsRepeater>
                        <TextBlock x:Name="TreeEmpty" Margin="16,14" Foreground="{StaticResource TextMuted}" TextWrapping="Wrap" Visibility="Collapsed"/>
                    </StackPanel>
                </Border>
            </Grid>

            <Grid x:Name="OptionsGrid" ColumnSpacing="16">
                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                <Border Style="{StaticResource Card}" Padding="16">
                    <StackPanel Spacing="10">
                        <TextBlock Text="{s:T K='Se o arquivo já existir'}" FontSize="13" FontWeight="SemiBold"/>
                        <Border Style="{StaticResource SegHost}" Background="{StaticResource SurfaceDeep}" HorizontalAlignment="Stretch">
                            <Grid ColumnSpacing="4">
                                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                                <RadioButton x:Name="ConfSkip" Style="{StaticResource SegSmall}" Height="32" GroupName="conf" Content="{s:T K='Pular'}" IsChecked="True"/>
                                <RadioButton x:Name="ConfOver" Grid.Column="1" Style="{StaticResource SegSmall}" Height="32" GroupName="conf" Content="{s:T K='Substituir'}"/>
                                <RadioButton x:Name="ConfBoth" Grid.Column="2" Style="{StaticResource SegSmall}" Height="32" GroupName="conf" Content="{s:T K='Manter os dois'}"/>
                            </Grid>
                        </Border>
                        <TextBlock Style="{StaticResource Small}" Text="{s:T K='Arquivos iguais aos do backup (mesmo tamanho e data) são sempre pulados.'}"/>
                    </StackPanel>
                </Border>
                <Border Grid.Column="1" Style="{StaticResource Card}" Padding="16">
                    <StackPanel Spacing="10">
                        <TextBlock Text="{s:T K='Restaurar para'}" FontSize="13" FontWeight="SemiBold"/>
                        <Border Style="{StaticResource SegHost}" Background="{StaticResource SurfaceDeep}" HorizontalAlignment="Stretch">
                            <Grid ColumnSpacing="4">
                                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                                <RadioButton x:Name="TargetMe" Style="{StaticResource SegSmall}" Height="32" Padding="6,0" GroupName="target" Content="{s:T K='Locais originais'}" IsChecked="True" Checked="OnTarget"/>
                                <RadioButton x:Name="TargetUser" Grid.Column="1" Style="{StaticResource SegSmall}" Height="32" Padding="6,0" GroupName="target" Content="{s:T K='Outro usuário'}" Checked="OnTarget"/>
                                <RadioButton x:Name="TargetFolder" Grid.Column="2" Style="{StaticResource SegSmall}" Height="32" Padding="6,0" GroupName="target" Content="{s:T K='Outra pasta'}" Checked="OnTarget"/>
                            </Grid>
                        </Border>
                        <Grid x:Name="TargetRow" ColumnSpacing="8" Visibility="Collapsed">
                            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <TextBox x:Name="TargetBox" Style="{StaticResource MonoInput}" Height="34" MinHeight="34" AutomationProperties.Name="{s:T K='Destino da restauração'}"/>
                            <Button Grid.Column="1" Style="{StaticResource SmallButton}" Height="34" Padding="12,0" FontSize="12" Content="{s:T K='Procurar…'}" Click="OnBrowseTarget"/>
                        </Grid>
                        <TextBlock x:Name="TargetHint" Style="{StaticResource Small}"
                                   Text="{s:T K='Cada pasta volta para onde estava. Documentos, Imagens e Área de Trabalho vão para onde essas pastas estão hoje (OneDrive incluído).'}"/>
                    </StackPanel>
                </Border>
            </Grid>

            <Border x:Name="RebootCard" Style="{StaticResource Card}" Padding="16,14">
                <Grid ColumnSpacing="14">
                    <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <c:ToggleRow x:Name="NoReboot" Title="{s:T K='Não reiniciar o computador após instalar drivers'}" Description="{s:T K='Os drivers são instalados normalmente; só o reinício no fim é pulado'}" Danger="True"/>
                    <TextBlock x:Name="NoRebootStatus" Grid.Column="1" Text="{s:T K='Reinicia após os drivers'}" FontSize="12" Foreground="{StaticResource TextMuted}" VerticalAlignment="Center"/>
                </Grid>
            </Border>

            <StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Right">
                <Button Style="{StaticResource SecondaryButton}" Content="{s:T K='Cancelar'}" Click="OnCancel"/>
                <Button x:Name="RestoreButton" Style="{StaticResource PrimaryButton}" Content="{s:T K='Restaurar'}" Click="OnRestore"/>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</Page>
