<Page
    x:Class="WINbackup.Pages.RestorePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:c="using:WINbackup.Controls"
    xmlns:m="using:WINbackup.Models">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Spacing="18" Padding="36,28,36,36">
            <Grid ColumnSpacing="16">
                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel Spacing="4">
                    <TextBlock Text="Restaurar backup" Style="{StaticResource H1}"/>
                    <TextBlock Text="Escolha a versão, navegue pelo conteúdo e traga de volta só o que precisa." Style="{StaticResource Sub}"/>
                </StackPanel>
                <Button Grid.Column="1" Style="{StaticResource AccentButton}" Height="36" Padding="14,0" FontSize="13" VerticalAlignment="Bottom" Click="OnWizard">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <c:Icon Width="14" Height="14" StrokeThickness="2" Data="M5 19 15 9M14 4v3M12.5 5.5h3M19 9v3M17.5 10.5h3"/>
                        <TextBlock Text="Restaurar tudo (pós-formatação)"/>
                    </StackPanel>
                </Button>
            </Grid>
            <c:PreviewNotice Text="Prévia: a restauração de arquivos entra numa próxima versão. Hoje dá para restaurar os drivers na tela Drivers, aba Restaurar. Os backups de arquivos ficam como pastas comuns no destino e podem ser copiados de volta pelo Explorer."/>

            <Grid x:Name="MainGrid" ColumnSpacing="16">
                <Grid.ColumnDefinitions><ColumnDefinition Width="340"/><ColumnDefinition/></Grid.ColumnDefinitions>
                <StackPanel Spacing="14">
                    <Border Style="{StaticResource Card}" Padding="16">
                        <StackPanel Spacing="8">
                            <TextBlock Text="Local do backup" FontSize="13" FontWeight="SemiBold"/>
                            <Grid ColumnSpacing="8">
                                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <TextBox x:Name="SourceBox" Style="{StaticResource MonoInput}" AutomationProperties.Name="Local do backup"/>
                                <Button Grid.Column="1" Style="{StaticResource SmallButton}" Padding="12,0" FontSize="12" Content="Procurar…" Click="OnBrowse"/>
                            </Grid>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource TableCard}">
                        <StackPanel x:Name="VersionsPanel">
                            <Border Padding="16,12" BorderBrush="{StaticResource Divider}" BorderThickness="0,0,0,1">
                                <TextBlock Text="Versões" FontSize="13" FontWeight="SemiBold"/>
                            </Border>
                        </StackPanel>
                    </Border>
                    <Border x:Name="PasswordCard" Style="{StaticResource Card}" Padding="16" Background="{StaticResource CyanBg}" BorderBrush="{StaticResource CyanLine}" Visibility="Collapsed">
                        <StackPanel Spacing="8">
                            <TextBlock Text="Senha do backup" FontSize="13" FontWeight="SemiBold"/>
                            <PasswordBox AutomationProperties.Name="Senha do backup" CornerRadius="8"/>
                            <TextBlock Text="Esta versão foi criptografada (AES-256)" FontSize="12" Foreground="{StaticResource NeonSoft}"/>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <Border Grid.Column="1" Style="{StaticResource TableCard}" VerticalAlignment="Top">
                    <StackPanel>
                        <Grid Padding="16,12" ColumnSpacing="10" BorderBrush="{StaticResource Divider}" BorderThickness="0,0,0,1">
                            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <TextBlock Text="Conteúdo do backup" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                            <TextBox Grid.Column="1" Style="{StaticResource Input}" Width="180" Height="30" MinHeight="30" FontSize="12" PlaceholderText="Buscar arquivo…" AutomationProperties.Name="Buscar arquivo"/>
                        </Grid>
                        <ItemsRepeater x:Name="Tree">
                            <ItemsRepeater.ItemTemplate>
                                <DataTemplate x:DataType="m:CheckItem">
                                    <ToggleButton Style="{StaticResource CheckRow}" Padding="{x:Bind Indent}" BorderBrush="#121c33" IsChecked="{x:Bind IsChecked, Mode=TwoWay}" AutomationProperties.Name="{x:Bind Title}">
                                        <Grid ColumnSpacing="10">
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                            <c:Icon Width="16" Height="16" Data="{x:Bind Icon}" Foreground="{x:Bind MetaBrush}"/>
                                            <TextBlock Grid.Column="1" Text="{x:Bind Title}" FontSize="13" FontWeight="{x:Bind Weight}" VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="2" Text="{x:Bind Meta}" FontSize="12" Foreground="{StaticResource TextMuted}" VerticalAlignment="Center"/>
                                        </Grid>
                                    </ToggleButton>
                                </DataTemplate>
                            </ItemsRepeater.ItemTemplate>
                        </ItemsRepeater>
                    </StackPanel>
                </Border>
            </Grid>

            <Grid ColumnSpacing="16">
                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                <Border Style="{StaticResource Card}" Padding="16">
                    <StackPanel Spacing="10">
                        <TextBlock Text="Se o arquivo já existir" FontSize="13" FontWeight="SemiBold"/>
                        <Border Style="{StaticResource SegHost}" Background="{StaticResource SurfaceDeep}" HorizontalAlignment="Stretch">
                            <Grid ColumnSpacing="4">
                                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                                <RadioButton Style="{StaticResource SegSmall}" Height="32" GroupName="conf" Content="Pular" IsChecked="True"/>
                                <RadioButton Grid.Column="1" Style="{StaticResource SegSmall}" Height="32" GroupName="conf" Content="Substituir"/>
                                <RadioButton Grid.Column="2" Style="{StaticResource SegSmall}" Height="32" GroupName="conf" Content="Manter os dois"/>
                            </Grid>
                        </Border>
                    </StackPanel>
                </Border>
                <Border Grid.Column="1" Style="{StaticResource Card}" Padding="16">
                    <StackPanel Spacing="10">
                        <TextBlock Text="Restaurar para" FontSize="13" FontWeight="SemiBold"/>
                        <Border Style="{StaticResource SegHost}" Background="{StaticResource SurfaceDeep}" HorizontalAlignment="Stretch">
                            <Grid ColumnSpacing="4">
                                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                                <RadioButton Style="{StaticResource SegSmall}" Height="32" GroupName="target" Content="Usuário atual" Tag="me" IsChecked="True" Checked="OnTarget"/>
                                <RadioButton Grid.Column="1" Style="{StaticResource SegSmall}" Height="32" GroupName="target" Content="Outro usuário" Tag="user" Checked="OnTarget"/>
                                <RadioButton Grid.Column="2" Style="{StaticResource SegSmall}" Height="32" GroupName="target" Content="Outra pasta" Tag="path" Checked="OnTarget"/>
                            </Grid>
                        </Border>
                        <TextBox x:Name="TargetBox" Style="{StaticResource MonoInput}" Height="34" MinHeight="34" Visibility="Collapsed" AutomationProperties.Name="Destino da restauração"/>
                    </StackPanel>
                </Border>
            </Grid>

            <Border Style="{StaticResource Card}" Padding="16,14">
                <Grid ColumnSpacing="14">
                    <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <c:ToggleRow x:Name="NoReboot" Title="Não reiniciar o computador após instalar drivers" Description="Os drivers são instalados normalmente; só o reinício automático é pulado" Danger="True"/>
                    <TextBlock x:Name="NoRebootStatus" Grid.Column="1" Text="Reinicia após os drivers" FontSize="12" Foreground="{StaticResource TextMuted}" VerticalAlignment="Center"/>
                </Grid>
            </Border>

            <StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Right">
                <Button Style="{StaticResource SecondaryButton}" Content="Cancelar" Click="OnCancel"/>
                <Button x:Name="RestoreButton" Style="{StaticResource PrimaryButton}" Click="OnSoon"/>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</Page>
