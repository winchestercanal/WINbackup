<Page
    x:Class="WINbackup.Pages.HistoryPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:c="using:WINbackup.Controls"
    xmlns:m="using:WINbackup.Models">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Spacing="20" Padding="36,28,36,36">
            <Grid ColumnSpacing="16">
                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel Spacing="4">
                    <TextBlock Text="Histórico e versões" Style="{StaticResource H1}"/>
                    <TextBlock Text="Cada backup vira uma versão. Volte para qualquer uma delas." Style="{StaticResource Sub}"/>
                </StackPanel>
                <Border Grid.Column="1" Style="{StaticResource SegHost}" VerticalAlignment="Bottom">
                    <StackPanel Orientation="Horizontal" Spacing="4">
                        <RadioButton x:Name="TabV" Style="{StaticResource Seg}" GroupName="tab" Content="Versões" IsChecked="True"/>
                        <RadioButton x:Name="TabL" Style="{StaticResource Seg}" GroupName="tab" Content="Logs"/>
                    </StackPanel>
                </Border>
            </Grid>

            <StackPanel x:Name="VersionsTab" Spacing="16">
                <Border Style="{StaticResource Card}" Padding="18,14">
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <StackPanel Spacing="2">
                            <TextBlock Text="Retenção" FontWeight="SemiBold"/>
                            <TextBlock Style="{StaticResource Small}" Text="Vale para cada tipo de backup. As mais antigas são apagadas ao fim de um backup sem erros; o último completo e as versões das quais as mantidas dependem nunca são apagadas."/>
                        </StackPanel>
                        <TextBlock Grid.Column="1" Text="Manter as últimas" FontSize="13" Foreground="{StaticResource TextMuted2}" VerticalAlignment="Center"/>
                        <Border Grid.Column="2" BorderBrush="{StaticResource LineButton}" BorderThickness="1" CornerRadius="8" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal">
                                <Button Style="{StaticResource FlatButton}" Width="36" Height="34" CornerRadius="0" Background="{StaticResource ButtonBg}" Content="−" FontSize="16" Click="OnDec" AutomationProperties.Name="Menos"/>
                                <TextBlock x:Name="KeepText" Width="44" TextAlignment="Center" FontWeight="Bold" FontFamily="{StaticResource Mono}" VerticalAlignment="Center"/>
                                <Button Style="{StaticResource FlatButton}" Width="36" Height="34" CornerRadius="0" Background="{StaticResource ButtonBg}" Content="+" FontSize="16" Click="OnInc" AutomationProperties.Name="Mais"/>
                            </StackPanel>
                        </Border>
                        <TextBlock Grid.Column="3" Text="versões" FontSize="13" Foreground="{StaticResource TextMuted2}" VerticalAlignment="Center"/>
                    </Grid>
                </Border>

                <Border Style="{StaticResource TableCard}">
                    <StackPanel x:Name="VersionsPanel">
                        <Grid Padding="18,10" ColumnSpacing="12" BorderBrush="{StaticResource Divider}" BorderThickness="0,0,0,1">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="1.8*"/><ColumnDefinition Width="1*"/><ColumnDefinition Width="0.9*"/><ColumnDefinition Width="1.2*"/><ColumnDefinition Width="1*"/><ColumnDefinition Width="1.6*"/></Grid.ColumnDefinitions>
                            <TextBlock Text="Data" Style="{StaticResource Small}"/>
                            <TextBlock Grid.Column="1" Text="Tipo" Style="{StaticResource Small}"/>
                            <TextBlock Grid.Column="2" Text="Tamanho" Style="{StaticResource Small}"/>
                            <TextBlock Grid.Column="3" Text="Integridade" Style="{StaticResource Small}"/>
                            <TextBlock Grid.Column="4" Text="Proteção" Style="{StaticResource Small}"/>
                        </Grid>
                    </StackPanel>
                </Border>
            </StackPanel>

            <StackPanel x:Name="LogsTab" Spacing="14" Visibility="Collapsed">
                <Grid>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <RadioButton Style="{StaticResource FilterRadio}" GroupName="lf" Content="Tudo" Tag="all" IsChecked="True" Checked="OnLogFilter"/>
                        <RadioButton Style="{StaticResource FilterRadio}" GroupName="lf" Content="Info" Tag="info" Checked="OnLogFilter"/>
                        <RadioButton Style="{StaticResource FilterRadio}" GroupName="lf" Content="Avisos" Tag="warn" Checked="OnLogFilter"/>
                        <RadioButton Style="{StaticResource FilterRadio}" GroupName="lf" Content="Erros" Tag="err" Checked="OnLogFilter"/>
                    </StackPanel>
                    <Button Style="{StaticResource SmallButton}" Height="32" Padding="12,0" FontSize="12" Content="Abrir pasta de logs" HorizontalAlignment="Right" Click="OnOpenLogs"/>
                </Grid>
                <TextBlock x:Name="LogSource" Style="{StaticResource Small}" FontFamily="{StaticResource Mono}"/>
                <Border Style="{StaticResource ConsoleCard}" Padding="18,16">
                    <ItemsControl x:Name="LogLines">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="m:LogLine">
                                <Grid ColumnSpacing="14" Margin="0,0,0,6">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="64"/><ColumnDefinition/></Grid.ColumnDefinitions>
                                    <TextBlock Text="{x:Bind Time}" FontFamily="{StaticResource Mono}" FontSize="12.5" Foreground="{StaticResource TextLabel}"/>
                                    <TextBlock Grid.Column="1" Text="{x:Bind LevelTag}" FontFamily="{StaticResource Mono}" FontSize="12.5" Foreground="{x:Bind LevelBrush}"/>
                                    <TextBlock Grid.Column="2" Text="{x:Bind Message}" FontFamily="{StaticResource Mono}" FontSize="12.5" Foreground="{StaticResource TextMono}" TextWrapping="Wrap"/>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Border>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</Page>
