<Page
    x:Class="WINbackup.Pages.FilesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:s="using:WINbackup.Services"
    xmlns:c="using:WINbackup.Controls"
    xmlns:m="using:WINbackup.Models">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Spacing="20" Padding="36,28,36,36">

            <Grid ColumnSpacing="20">
                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="320"/></Grid.ColumnDefinitions>
                <StackPanel Spacing="4" VerticalAlignment="Bottom">
                    <TextBlock Text="{s:T K='Arquivos pessoais'}" Style="{StaticResource H1}"/>
                    <TextBlock Text="{s:T K='Suas pastas do usuário e as pastas que você escolher.'}" Style="{StaticResource Sub}"/>
                </StackPanel>
                <Border Grid.Column="1" Style="{StaticResource Card}" Padding="14,12" CornerRadius="10">
                    <StackPanel Spacing="8">
                        <Grid>
                            <TextBlock Text="{s:T K='Estimativa do backup'}" FontSize="12" Foreground="{StaticResource TextMuted}"/>
                            <TextBlock x:Name="EstText" Text="{s:T K='Calculando…'}" FontSize="12" FontWeight="SemiBold" HorizontalAlignment="Right"/>
                        </Grid>
                        <Grid Height="8" CornerRadius="4" Background="{StaticResource SidebarDivider}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition x:Name="EstCol" Width="0*"/>
                                <ColumnDefinition x:Name="RestCol" Width="1*"/>
                            </Grid.ColumnDefinitions>
                            <Border x:Name="EstBar" Background="{StaticResource Neon}"/>
                        </Grid>
                        <TextBlock x:Name="FitText" FontSize="12" Foreground="{StaticResource TextMuted}" Text=" "/>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Pastas conhecidas redirecionadas para o OneDrive (Known Folder Move) -->
            <Border x:Name="CloudBanner" Style="{StaticResource InfoCard}" CornerRadius="12" Visibility="Collapsed">
                <Grid ColumnSpacing="14">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <c:Icon Width="22" Height="22" Data="M7 18h11a4 4 0 0 0 .5-8 6 6 0 0 0-11.5-1.5A4.5 4.5 0 0 0 7 18z" Foreground="{StaticResource BlueSoft}" VerticalAlignment="Center"/>
                    <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                        <TextBlock x:Name="CloudTitle" FontWeight="SemiBold" TextWrapping="Wrap"/>
                        <TextBlock FontSize="12" Foreground="{StaticResource TextMuted2}" TextWrapping="Wrap">
                            <Run Text="{s:T K='Vamos copiar das pastas reais em '}"/><Run Text="{s:T K='%OneDrive%\…'}" FontFamily="{StaticResource Mono}"/><Run Text="{s:T K=' em vez das pastas padrão, que estão vazias.'}"/>
                        </TextBlock>
                    </StackPanel>
                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                        <TextBlock FontSize="12" Foreground="{StaticResource TextMuted2}" TextAlignment="Right" VerticalAlignment="Center" Text="{s:T K='Baixar arquivos&#x0a;só na nuvem'}"/>
                        <ToggleButton x:Name="CloudSwitch" Style="{StaticResource Switch}" AutomationProperties.Name="{s:T K='Baixar arquivos só na nuvem'}"/>
                    </StackPanel>
                </Grid>
            </Border>

            <Grid>
                <Border Style="{StaticResource SegHost}">
                    <StackPanel Orientation="Horizontal" Spacing="4">
                        <RadioButton x:Name="ModeC" Style="{StaticResource Seg}" GroupName="mode" Content="{s:T K='Completo'}"/>
                        <RadioButton x:Name="ModeS" Style="{StaticResource Seg}" GroupName="mode" Content="{s:T K='Seletivo'}"/>
                    </StackPanel>
                </Border>
                <TextBlock x:Name="SelCount" FontSize="12" Foreground="{StaticResource TextMuted}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
            </Grid>

            <ItemsRepeater x:Name="FolderRepeater">
                <ItemsRepeater.Layout>
                    <UniformGridLayout MaximumRowsOrColumns="3" ItemsStretch="Fill" MinItemWidth="230" MinItemHeight="64" MinColumnSpacing="10" MinRowSpacing="10"/>
                </ItemsRepeater.Layout>
                <ItemsRepeater.ItemTemplate>
                    <DataTemplate x:DataType="m:CheckItem">
                        <Grid>
                            <ToggleButton Style="{StaticResource CheckCard}" IsChecked="{x:Bind IsChecked, Mode=TwoWay}" IsEnabled="{x:Bind Enabled, Mode=OneWay}"
                                          Visibility="{x:Bind ItemVisibility}" ContextRequested="OnFolderContext" AutomationProperties.Name="{x:Bind Title}">
                                <Grid ColumnSpacing="8">
                                    <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <StackPanel Spacing="2">
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <TextBlock Text="{x:Bind Title}" FontSize="14" FontWeight="SemiBold"/>
                                            <c:Icon Width="14" Height="14" StrokeThickness="2" Foreground="{StaticResource BlueSoft}" Visibility="{x:Bind FlagVisibility}"
                                                    Data="M7 18h11a4 4 0 0 0 .5-8 6 6 0 0 0-11.5-1.5A4.5 4.5 0 0 0 7 18z" VerticalAlignment="Center"/>
                                        </StackPanel>
                                        <TextBlock Text="{x:Bind Subtitle}" Style="{StaticResource MonoText}" FontSize="11.5" Foreground="{StaticResource TextMuted}"/>
                                    </StackPanel>
                                    <TextBlock Grid.Column="1" Text="{x:Bind Meta, Mode=OneWay}" Foreground="{x:Bind MetaBrush, Mode=OneWay}" FontSize="12" VerticalAlignment="Center"/>
                                </Grid>
                            </ToggleButton>
                            <Button Style="{StaticResource FlatButton}" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" CornerRadius="10"
                                    Visibility="{x:Bind AddVisibility}" Click="OnAddFolder" Foreground="{StaticResource BlueLink}">
                                <Grid>
                                    <StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <c:Icon Width="16" Height="16" StrokeThickness="2" Data="M12 5v14M5 12h14"/>
                                        <TextBlock Text="{s:T K='Adicionar pasta'}" FontSize="13" FontWeight="SemiBold"/>
                                    </StackPanel>
                                </Grid>
                            </Button>
                            <Rectangle Visibility="{x:Bind AddVisibility}" RadiusX="10" RadiusY="10" Stroke="{StaticResource LineDashed}"
                                       StrokeDashArray="4,3" StrokeThickness="1" IsHitTestVisible="False"/>
                        </Grid>
                    </DataTemplate>
                </ItemsRepeater.ItemTemplate>
            </ItemsRepeater>

            <Grid ColumnSpacing="16">
                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                <Border Style="{StaticResource Card}">
                    <StackPanel Spacing="12">
                        <StackPanel Spacing="2">
                            <TextBlock Text="{s:T K='Exclusões'}" Style="{StaticResource CardTitle}"/>
                            <TextBlock Text="{s:T K='Pastas e padrões que nunca entram no backup'}" Style="{StaticResource Small}"/>
                        </StackPanel>
                        <c:WrapPanel x:Name="ExclChips"/>
                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <TextBox x:Name="ExclInput" Style="{StaticResource MonoInput}" PlaceholderText="{s:T K='Ex.: *.iso ou C:\\Users\\…\\AppData'}"
                                     AutomationProperties.Name="{s:T K='Nova exclusão'}" KeyDown="OnExclKey"/>
                            <Button Grid.Column="1" Style="{StaticResource SmallButton}" Content="{s:T K='Adicionar'}" Click="OnAddExcl"/>
                        </Grid>
                    </StackPanel>
                </Border>
                <Border Grid.Column="1" Style="{StaticResource Card}">
                    <StackPanel Spacing="14">
                        <TextBlock Text="{s:T K='Opções de cópia'}" Style="{StaticResource CardTitle}"/>
                        <c:ToggleRow x:Name="OptVss" Title="{s:T K='Copiar arquivos em uso (Shadow Copy)'}" Description="{s:T K='Usa o VSS do Windows para não pular arquivos travados'}"/>
                        <c:ToggleRow x:Name="OptIncr" Title="{s:T K='Incremental: copiar só o que mudou'}" Description="{s:T K='Mantém versões anteriores no destino'}"/>
                        <c:ToggleRow x:Name="OptAcl" Title="{s:T K='Preservar permissões e datas'}" Description="{s:T K='Copia as permissões (ACLs) além das datas e atributos'}"/>
                    </StackPanel>
                </Border>
            </Grid>

            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <c:SaveTargetBar Suffix="Arquivos"/>
                <Button Grid.Column="1" Style="{StaticResource SecondaryButton}" Content="{s:T K='Cancelar'}" Click="OnCancel"/>
                <Button Grid.Column="2" Style="{StaticResource PrimaryButton}" Content="{s:T K='Iniciar backup'}" Click="OnStart"/>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</Page>
