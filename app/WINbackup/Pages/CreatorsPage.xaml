<Page
    x:Class="WINbackup.Pages.CreatorsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:s="using:WINbackup.Services"
    xmlns:c="using:WINbackup.Controls"
    xmlns:m="using:WINbackup.Models">

    <Page.Resources>
        <DataTemplate x:Key="AppRow" x:DataType="m:CheckItem">
            <ToggleButton Style="{StaticResource CheckRow}" Padding="18,12" IsChecked="{x:Bind IsChecked, Mode=TwoWay}" IsEnabled="{x:Bind Enabled, Mode=OneWay}"
                          AutomationProperties.Name="{x:Bind Title}">
                <Grid ColumnSpacing="14">
                    <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <StackPanel Spacing="2">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock Text="{x:Bind Title}" FontSize="14" FontWeight="SemiBold"/>
                            <Border Visibility="{x:Bind FlagVisibility}" Padding="8,1" CornerRadius="6" Background="{StaticResource ChipWarnBg}" BorderBrush="{StaticResource WarnLine}" BorderThickness="1" VerticalAlignment="Center">
                                <TextBlock Text="{s:T K='Plugins'}" FontSize="11" Foreground="{StaticResource WarnText}"/>
                            </Border>
                        </StackPanel>
                        <TextBlock Text="{x:Bind Subtitle}" FontSize="12" Foreground="{StaticResource TextMuted}" TextWrapping="Wrap"/>
                        <TextBlock Text="{x:Bind Col1}" Style="{StaticResource MonoText}" FontSize="11.5" Foreground="{StaticResource TextLabel}"/>
                    </StackPanel>
                    <TextBlock Grid.Column="1" Text="{x:Bind Meta, Mode=OneWay}" FontSize="12" Foreground="{StaticResource TextMuted2}" VerticalAlignment="Center"/>
                </Grid>
            </ToggleButton>
        </DataTemplate>
    </Page.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Spacing="20" Padding="36,28,36,36">
            <Grid ColumnSpacing="20">
                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel Spacing="4">
                    <TextBlock Text="{s:T K='Criadores'}" Style="{StaticResource H1}"/>
                    <TextBlock Text="{s:T K='Presets, workspaces, scripts, macros e plugins dos programas de edição, design, lives, áudio e 3D.'}" Style="{StaticResource Sub}"/>
                </StackPanel>
                <Border Grid.Column="1" Style="{StaticResource Card}" Padding="14,12" CornerRadius="10" VerticalAlignment="Bottom" MinWidth="240">
                    <StackPanel Spacing="4">
                        <TextBlock x:Name="FoundText" FontSize="12" Foreground="{StaticResource TextMuted}"/>
                        <TextBlock x:Name="SizeText" Text="{s:T K='Calculando…'}" FontSize="18" FontWeight="Bold"/>
                    </StackPanel>
                </Border>
            </Grid>

            <Border Style="{StaticResource Card}" Padding="18,14">
                <c:ToggleRow x:Name="PluginsToggle" Title="{s:T K='Copiar também as pastas de plugins'}"
                             Description="{s:T K='Fica bem maior. Plugins pagos costumam precisar ser reinstalados ou reativados depois, mas os arquivos ficam guardados.'}"/>
            </Border>

            <StackPanel x:Name="CategoriesPanel" Spacing="16"/>

            <Border Style="{StaticResource Card}">
                <StackPanel Spacing="10">
                    <Grid>
                        <StackPanel Spacing="2">
                            <TextBlock Text="{s:T K='Outras pastas de criação'}" Style="{StaticResource CardTitle}"/>
                            <TextBlock Style="{StaticResource Small}" Text="{s:T K='Streamer.bot portátil, LUTs, templates, packs de overlays, bibliotecas de efeitos sonoros…'}"/>
                        </StackPanel>
                        <Button Style="{StaticResource SmallButton}" Content="{s:T K='Adicionar pasta'}" HorizontalAlignment="Right" VerticalAlignment="Center" Click="OnAddFolder"/>
                    </Grid>
                    <StackPanel x:Name="CustomPanel" Spacing="6"/>
                </StackPanel>
            </Border>

            <TextBlock x:Name="MissingText" Style="{StaticResource Small}" Foreground="{StaticResource TextLabel}"/>

            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <c:SaveTargetBar Suffix="Criadores"/>
                <Button x:Name="StartButton" Grid.Column="1" Style="{StaticResource PrimaryButton}" Content="{s:T K='Iniciar backup'}" Click="OnStart"/>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</Page>
