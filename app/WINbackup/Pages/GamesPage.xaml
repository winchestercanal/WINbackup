<Page
    x:Class="WINbackup.Pages.GamesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:c="using:WINbackup.Controls"
    xmlns:m="using:WINbackup.Models">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Spacing="20" Padding="36,28,36,36">
            <StackPanel Spacing="4">
                <TextBlock Text="Saves de jogos" Style="{StaticResource H1}"/>
                <TextBlock Text="Encontra o progresso dos seus jogos nas pastas mais comuns, para não começar do zero." Style="{StaticResource Sub}"/>
            </StackPanel>

            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                <Border Style="{StaticResource Card}" Padding="16,14">
                    <StackPanel Spacing="6"><TextBlock Text="Documentos e Saved Games" Style="{StaticResource MonoText}" Foreground="{StaticResource TextMuted}"/><TextBlock x:Name="StatLocal" Text="…" FontSize="18" FontWeight="Bold"/></StackPanel>
                </Border>
                <Border Grid.Column="1" Style="{StaticResource Card}" Padding="16,14">
                    <StackPanel Spacing="6"><TextBlock Text="Unreal e Unity (AppData)" Style="{StaticResource MonoText}" Foreground="{StaticResource TextMuted}"/><TextBlock x:Name="StatEngine" Text="…" FontSize="18" FontWeight="Bold"/></StackPanel>
                </Border>
                <Border Grid.Column="2" Style="{StaticResource Card}" Padding="16,14">
                    <StackPanel Spacing="6"><TextBlock Text="Steam Cloud e Ubisoft" Style="{StaticResource MonoText}" Foreground="{StaticResource TextMuted}"/><TextBlock x:Name="StatCloud" Text="…" FontSize="18" FontWeight="Bold"/></StackPanel>
                </Border>
            </Grid>

            <Border Style="{StaticResource TableCard}">
                <StackPanel>
                    <Grid Padding="18,10,14,10" BorderBrush="{StaticResource Divider}" BorderThickness="0,0,0,1">
                        <TextBlock x:Name="SelText" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Right">
                            <TextBlock Text="Marcar:" FontSize="11.5" Foreground="{StaticResource TextLabel}" VerticalAlignment="Center" Margin="0,0,2,0"/>
                            <ToggleButton x:Name="QuickLocal" Style="{StaticResource PillToggle}" Content="Só locais" Click="OnQuick"/>
                            <ToggleButton x:Name="QuickCloud" Style="{StaticResource PillToggle}" Content="Só na nuvem" Click="OnQuick"/>
                            <ToggleButton x:Name="QuickAll" Style="{StaticResource PillToggle}" Content="Todos" Click="OnQuick"/>
                        </StackPanel>
                    </Grid>
                    <Grid Padding="54,10,18,10" ColumnSpacing="12" BorderBrush="{StaticResource Divider}" BorderThickness="0,0,0,1">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="1.6*"/><ColumnDefinition Width="2.4*"/><ColumnDefinition Width="0.8*"/><ColumnDefinition Width="1.3*"/></Grid.ColumnDefinitions>
                        <TextBlock Text="Jogo" Style="{StaticResource Small}"/>
                        <TextBlock Grid.Column="1" Text="Local do save" Style="{StaticResource Small}"/>
                        <TextBlock Grid.Column="2" Text="Tamanho" Style="{StaticResource Small}"/>
                        <TextBlock Grid.Column="3" Text="Nuvem" Style="{StaticResource Small}"/>
                    </Grid>
                    <StackPanel x:Name="Loading" Orientation="Horizontal" Spacing="12" Padding="18,22">
                        <ProgressRing IsActive="True" Width="20" Height="20" Foreground="{StaticResource Neon}"/>
                        <TextBlock Text="Procurando saves de jogos…" Foreground="{StaticResource TextMuted}" VerticalAlignment="Center"/>
                    </StackPanel>
                    <ItemsRepeater x:Name="Rows">
                        <ItemsRepeater.ItemTemplate>
                            <DataTemplate x:DataType="m:CheckItem">
                                <ToggleButton Style="{StaticResource CheckRow}" Padding="18,12" IsChecked="{x:Bind IsChecked, Mode=TwoWay}" AutomationProperties.Name="{x:Bind Title}">
                                    <Grid ColumnSpacing="12">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="1.6*"/><ColumnDefinition Width="2.4*"/><ColumnDefinition Width="0.8*"/><ColumnDefinition Width="1.3*"/></Grid.ColumnDefinitions>
                                        <StackPanel Spacing="1" VerticalAlignment="Center"><TextBlock Text="{x:Bind Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/><TextBlock Text="{x:Bind Col2}" FontSize="11.5" Foreground="{StaticResource TextLabel}"/></StackPanel>
                                        <TextBlock Grid.Column="1" Text="{x:Bind Subtitle}" Style="{StaticResource MonoText}" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="2" Text="{x:Bind Col1, Mode=OneWay}" FontSize="12" Foreground="{StaticResource TextMuted2}" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="3" Text="{x:Bind Meta}" FontSize="12" Foreground="{x:Bind MetaBrush}" VerticalAlignment="Center"/>
                                    </Grid>
                                </ToggleButton>
                            </DataTemplate>
                        </ItemsRepeater.ItemTemplate>
                    </ItemsRepeater>
                </StackPanel>
            </Border>

            <Grid ColumnSpacing="16">
                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                <Border Style="{StaticResource Card}">
                    <StackPanel Spacing="10">
                        <TextBlock Text="Bibliotecas da Steam" Style="{StaticResource CardTitle}"/>
                        <TextBlock Text="Salvamos só os caminhos, para a Steam reconhecer os jogos já instalados em outro disco." Style="{StaticResource Small}"/>
                        <StackPanel x:Name="LibrariesPanel" Spacing="6"/>
                    </StackPanel>
                </Border>
                <Border Grid.Column="1" Style="{StaticResource Card}">
                    <StackPanel Spacing="14">
                        <TextBlock Text="Opções" Style="{StaticResource CardTitle}"/>
                        <c:ToggleRow x:Name="SkipCloud" Title="Pular jogos com save na nuvem" Description="Steam Cloud, Xbox e similares já guardam o progresso"/>
                    </StackPanel>
                </Border>
            </Grid>

            <StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Right">
                <Button Style="{StaticResource SecondaryButton}" Content="Adicionar jogo manualmente" Click="OnAddGame"/>
                <Button x:Name="SaveButton" Style="{StaticResource PrimaryButton}" Content="Salvar saves" Click="OnSave"/>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</Page>
