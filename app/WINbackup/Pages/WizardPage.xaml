<Page
    x:Class="WINbackup.Pages.WizardPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:c="using:WINbackup.Controls">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Spacing="20" Padding="36,28,36,36">
            <StackPanel Spacing="4">
                <TextBlock Text="ACABEI DE FORMATAR" FontSize="12" FontWeight="Bold" CharacterSpacing="100" Foreground="{StaticResource Neon}"/>
                <TextBlock Text="Modo pós-formatação" Style="{StaticResource H1}"/>
                <TextBlock Text="Deixa o PC como estava, numa ordem pensada para não dar conflito. Você pode sair e voltar depois." Style="{StaticResource Sub}"/>
            </StackPanel>

            <Border Style="{StaticResource Card}" Padding="18,14">
                <Grid ColumnSpacing="14">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <c:Icon Width="20" Height="20" Foreground="{StaticResource Neon}" Data="M3 13h18v7H3zM5 13 7.5 5h9L19 13" VerticalAlignment="Center"/>
                    <TextBlock x:Name="FoundText" Grid.Column="1" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                    <Button Grid.Column="2" Style="{StaticResource LinkButton}" Content="Trocar" Click="OnChange"/>
                </Grid>
            </Border>

            <Grid x:Name="MainGrid" ColumnSpacing="16">
                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="320"/></Grid.ColumnDefinitions>
                <Border Style="{StaticResource TableCard}" VerticalAlignment="Top">
                    <StackPanel x:Name="StepsPanel"/>
                </Border>
                <StackPanel Grid.Column="1" Spacing="14">
                    <Border Style="{StaticResource Card}">
                        <StackPanel Spacing="14">
                            <TextBlock Text="Como executar" Style="{StaticResource CardTitle}"/>
                            <c:ToggleRow x:Name="NoReboot" Title="Não reiniciar o computador" Description="Instala os drivers sem reiniciar no meio da restauração" Danger="True"/>
                            <c:ToggleRow x:Name="Silent" Title="Sem perguntas" Description="Usa as respostas padrão em todos os conflitos"/>
                            <c:ToggleRow x:Name="NotifyEnd" Title="Avisar quando terminar" Description="Notificação do Windows com o resumo"/>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource Card}" Padding="18,16" Background="{StaticResource SurfaceStrong}" BorderBrush="{StaticResource LineStrong}">
                        <StackPanel Spacing="6">
                            <TextBlock Text="Tempo estimado" Style="{StaticResource Small}"/>
                            <TextBlock x:Name="EstimateText" FontSize="22" FontWeight="Bold" FontFamily="{StaticResource Mono}"/>
                            <TextBlock x:Name="StepsNote" Style="{StaticResource Small}"/>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource ConsoleCard}" Padding="16,14">
                        <StackPanel Spacing="6">
                            <TextBlock Text="Mesmo processo pela linha de comando:" Style="{StaticResource Small}"/>
                            <TextBlock Text="WINbackup.exe --restore E:\Backup --postformat --silent" FontFamily="{StaticResource Mono}" FontSize="11.5" LineHeight="18" Foreground="{StaticResource NeonSoft}" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>

            <StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Right">
                <Button Style="{StaticResource SecondaryButton}" Content="Agora não" Click="OnCancel"/>
                <Button Style="{StaticResource PrimaryButton}" Content="Iniciar restauração completa" Click="OnStart"/>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</Page>
